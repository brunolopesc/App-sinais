:root {
  --bg: #0a0d12;
  --card: #12161d;
  --border: #1e2530;
  --border-hover: #2a3341;
  --text: #e8eaed;
  --muted: #6b7280;
  --green: #10d9a3;
  --green-bg: rgba(16, 217, 163, 0.12);
  --red: #ff5c72;
  --red-bg: rgba(255, 92, 114, 0.12);
  --amber: #f5a623;
  --amber-bg: rgba(245, 166, 35, 0.12);
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.mono { font-family: ui-monospace, "SF Mono", Menlo, monospace; }

.wrap { max-width: 900px; margin: 0 auto; padding: 24px 18px 60px; }

.card {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 14px;
  padding: 16px;
}

input, select, button {
  font-family: inherit;
  font-size: 14px;
}

input, select {
  background: #0d1117;
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text);
  padding: 10px 12px;
  outline: none;
  width: 100%;
}
input:focus, select:focus { border-color: var(--green); }

button {
  cursor: pointer;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  padding: 10px 16px;
}

.btn-primary { background: var(--green); color: #0a0d12; }
.btn-primary:hover { opacity: 0.9; }
.btn-ghost { background: transparent; color: var(--muted); border: 1px solid var(--border); }
.btn-ghost:hover { color: var(--text); }

.badge {
  font-size: 11px;
  font-weight: 700;
  padding: 3px 10px;
  border-radius: 999px;
  border: 1px solid;
  letter-spacing: 0.03em;
}
.badge.ativo { background: var(--green-bg); color: var(--green); border-color: rgba(16,217,163,.4); }
.badge.teste { background: var(--amber-bg); color: var(--amber); border-color: rgba(245,166,35,.4); }
.badge.bloqueado { background: var(--red-bg); color: var(--red); border-color: rgba(255,92,114,.4); }

.err { color: var(--red); font-size: 13px; margin: 8px 0; }
.center-screen {
  min-height: 100vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
}
.hidden { display: none !important; }

.card-sinal {
  border-color: rgba(30,37,48,0.9);
  background: linear-gradient(180deg, rgba(18,22,29,0.9), rgba(10,13,18,0.9));
  transition: border-color .2s, transform .2s;
}
.card-sinal:hover {
  border-color: var(--green);
  transform: translateY(-2px);
}
#seletor-tf { box-shadow: 0 0 0 1px rgba(16,217,163,0.15) inset; }
h1 {
  background: linear-gradient(90deg, #e8eaed, #10d9a3);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
}
